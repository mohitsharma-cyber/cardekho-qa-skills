  "learned_workflows": {
    "change_url": {
      "description": "Deterministic sequence to update target server in CarDekho App without trial-and-error",
      "steps": [
        "Open drawer at (75, 175)",
        "Tap Change URL at (140, 1950)",
        "Tap Base URL at (850, 450), select all & delete, type new base_url",
        "Tap Base API URL at (850, 750), select all & delete, type new base_api_url",
        "Dismiss keyboard with keyevent 111",
        "Tap UPDATE button at (880, 1650)",
        "Assert Updated Successfully toast",
        "Tap back arrow at (80, 85) to return to Home"
      ]
    },
    "popup_free_execution": {
      "description": "Zero IDE Security Dialog execution protocol",
      "rule": "Execute atomic tasks via fast_runner.py instead of inline shell command chaining"
    },
    "parallel_live_device_execution": {
      "description": "All test actions, gestures, clicks, and validations execute in real-time directly on the connected physical device via ADB",
      "rule": "Execute live ADB commands parallelly on the connected hardware and mirror live screencap state back to the chat immediately without detached simulation"
    },
    "girnar_jira_workflow": {
      "name": "Girnar-2024-v1 - Workflow - Story",
      "stages": [
        "CREATE TICKET",
        "DESIGN REQUIRED",
        "IN DESIGN",
        "DESIGN IN REVIEW",
        "PRIORITIZE",
        "DEV IN PROGRESS",
        "CODE REVIEW",
        "DEV COMPLETE",
        "PENDING DEPLOYMENT",
        "SANITY TESTING",
        "IN QA",
        "IN UAT",
        "DEV DONE",
        "CLOSED",
        "ON-HOLD",
        "CANCELLED",
        "DUPLICATE"
      ],
      "qa_transitions": {
        "from_in_qa": {
          "qa_pass_signoff": {
            "transition_name": "QA Complete",
            "transition_id": 111,
            "target_status": "IN UAT",
            "action": "Triggered automatically when QA Sign-Off comment is posted"
          },
          "qa_fail_defect": {
            "transition_name": "Dev In Progress",
            "target_status": "DEV IN PROGRESS",
            "action": "Triggered when blocking bugs are found and QA is rejected"
          },
          "hold": {
            "transition_name": "On-Hold",
            "transition_id": 501,
            "target_status": "ON-HOLD"
          },
          "close": {
            "transition_name": "Closed",
            "transition_id": 271,
            "target_status": "CLOSED"
          }
        },
        "from_in_uat": {
          "uat_complete": {
            "transition_name": "Dev Done",
            "transition_id": 421,
            "target_status": "DEV DONE"
          },
          "close": {
            "transition_name": "Closed",
            "transition_id": 271,
            "target_status": "CLOSED"
          }
        }
      }
    },
    "safe_vertical_scroll": {
      "description": "Always scroll vertically along the screen's left neutral margin (x=100) to prevent getting trapped inside horizontal scrollviews/carousels (like video shorts or model chips).",
      "safe_margin_x": 100
    },
    "multi_stage_jira_transition": {
      "description": "If ticket is in Dev Complete, auto-transition to In QA (ID: 91) first, and then execute QA Complete (ID: 111) to reach In UAT seamlessly.",
      "chain": [
        "Dev Complete -> In QA",
        "In QA -> In UAT (QA Complete)"
      ]
    }
  },
  "learned_rules": {
    "mandatory_physical_device_execution": "Strictly forbidden to verify UI/WAP/App solely via curl/python HTTP requests. Must traverse on physical OnePlus 12R hardware with real screencaps.",
    "zero_server_assumption": "Never assume or pick a server from past conversation. Must verify via Jira comments/Jenkins or confirm from user explicitly.",
    "pre_check_summary_mandate": "Always emit [PRE-CHECK SUMMARY] before executing tests.",
    "dev_scope_validation": "Do not blindly accept dev comments that exclude platforms (e.g. App) if Jira ticket mandates universal changes."
  }
